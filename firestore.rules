rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /layouts/{layoutId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'title', 'author', 'ownerId', 'items',
          'autoScore', 'autoReviewVersion', 'autoReview',
          'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 40
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 40
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 20
        && request.resource.data.autoScore is int
        && request.resource.data.autoScore >= 0
        && request.resource.data.autoScore <= 100
        && request.resource.data.autoReviewVersion == 1
        && request.resource.data.autoReview is map
        && request.resource.data.createdAt == request.time;

      // An owner can remove their own published layout.
      // The app currently does not expose this button yet.
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Published layouts are immutable in the MVP.
      allow update: if false;
    }

    match /votes/{voteId} {
      allow read: if request.auth != null;

      // Deterministic voteId = UID_layoutId.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId', 'layoutId', 'value', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.layoutId is string
        && voteId == request.auth.uid + '_' + request.resource.data.layoutId
        && (request.resource.data.value == 0 || request.resource.data.value == 1)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/layouts/$(request.resource.data.layoutId));

      // The same user may change only their own vote value.
      // userId/layoutId stay immutable and the deterministic doc id stays the same.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'layoutId', 'value', 'createdAt'
        ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.layoutId == resource.data.layoutId
        && voteId == request.auth.uid + '_' + resource.data.layoutId
        && (request.resource.data.value == 0 || request.resource.data.value == 1)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/layouts/$(resource.data.layoutId));

      allow delete: if false;
    }
  }
}
