rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /layouts/{layoutId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'title', 'author', 'ownerId', 'items', 'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 40
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 40
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 20
        && request.resource.data.createdAt == request.time;

      // An owner can remove their own published layout.
      // The app currently does not expose this button yet.
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Published layouts are immutable in the MVP.
      allow update: if false;
    }

    match /votes/{voteId} {
      allow read: if request.auth != null;

      // voteId is UID_layoutId, so one anonymous Firebase user gets
      // at most one immutable vote per layout.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId', 'layoutId', 'value', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.layoutId is string
        && voteId == request.auth.uid + '_' + request.resource.data.layoutId
        && (request.resource.data.value == 0 || request.resource.data.value == 1)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/layouts/$(request.resource.data.layoutId));

      allow update, delete: if false;
    }
  }
}
